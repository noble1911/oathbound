{
  "name": "oathbound",
  "private": true,
  "version": "2.0.0",
  "description": "1v1 fantasy army auto-battler in the browser: deploy squads each round, gear them with ARPG loot, and march on the enemy Keep.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/online.mjs",
    "preview:path": "npm run build && node tools/serve-prefixed.mjs dist oathbound 5190",
    "deploy": "bash scripts/deploy.sh",
    "art": "node tools/art/run.mjs",
    "tournament": "node tools/tournament.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "puppeteer-core": "^25.17.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
